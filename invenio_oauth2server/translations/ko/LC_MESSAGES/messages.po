#: invenio_oauth2server/templates/invenio_oauth2server/settings/token_view.html:22
#: invenio_oauth2server/templates/semantic-ui/invenio_oauth2server/settings/token_view.html:25
msgid "Please copy the personal access token now. You won't see it again!"
msgstr "지금 개인 액세스 토큰을 복사하십시오. 다시 표시되지 않습니다."

#: invenio_oauth2server/templates/invenio_oauth2server/settings/token_view.html:25
#: invenio_oauth2server/templates/semantic-ui/invenio_oauth2server/settings/token_view.html:30
msgid ""
"Do not share this personal access token. It gives full access to your "
"account."
msgstr "이 개인 액세스 토큰을 공유하지 마십시오. 계정에 대한 전체 접근 권한을 부여합니다."

#: invenio_oauth2server/templates/invenio_oauth2server/settings/token_view.html:36
#: invenio_oauth2server/templates/semantic-ui/invenio_oauth2server/settings/token_view.html:40
msgid ""
"If you've lost or forgotten this token please create a new one. Be aware "
"that any scripts or applications using this token will need to be updated."
msgstr "이 토큰을 잃어버렸거나 잊었다면 새로 만드십시오. 이 토큰을 사용하는 모든 스크립트나 어플리케이션을 업데이트해야 합니다."

